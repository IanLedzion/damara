  // Method GenerateValidationRules
  // Emits the metadata-driven RuleFor chains shared by the entity and
  // capability validators (nullability, required, range, length, pattern and
  // format rules); error codes are keyed by the entity class name either way.
  private void GenerateValidationRules(EntityClass cls, EntityProperty[] validationProperties) {
