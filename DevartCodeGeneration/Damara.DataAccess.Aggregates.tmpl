  // Method GetSubfolderOutput
  // An OutputInfo pointing at a subfolder of the given output, supporting both
  // folder-based and project-based output configurations.
  private OutputInfo GetSubfolderOutput(OutputInfo baseOutput, string subPath) {
    OutputInfo info = new OutputInfo();
    if (string.IsNullOrEmpty(baseOutput.Project)) {
      info.DestinationFolder = Path.Combine(baseOutput.DestinationFolder, subPath);
      Directory.CreateDirectory(info.DestinationFolder);
