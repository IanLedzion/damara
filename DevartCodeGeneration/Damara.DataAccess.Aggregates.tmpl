  // Method IsGenerated
  // Whether a class takes part in generation: entity classes require an
  // AggregateRootName; everything else always generates.
  private bool IsGenerated(BaseClass cls) {
    EntityClass entityClass = cls as EntityClass;
    if (entityClass == null)
      return true;
    return !string.IsNullOrEmpty((entityClass.GetProperty("AggregateRootName") as string ?? string.Empty).Trim());
  }

  // Method GetAggregateName
  // The aggregate an entity belongs to, from the AggregateRootName extended property.
  private string GetAggregateName(EntityClass cls) {
    string aggregateName = (cls.GetProperty("AggregateRootName") as string ?? string.Empty).Trim();
    if (string.IsNullOrEmpty(aggregateName))
      aggregateName = "UnassignedAggregate";
    return codeProvider.GetValidIdentifier(aggregateName);
