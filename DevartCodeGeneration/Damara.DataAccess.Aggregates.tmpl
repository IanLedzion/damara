  // Method GetCapabilityMembers
  // Capability name -> members tagged with it via the comma-separated
  // Capabilities extended property on Property and RelationProperty.
  private Dictionary<string, List<object>> GetCapabilityMembers(EntityClass cls) {
    var map = new Dictionary<string, List<object>>();
    foreach (EntityProperty property in cls.Properties.OfType<EntityProperty>())
      AddCapabilityMember(map, property.GetProperty("Capabilities") as string, property);
    foreach (EntityRelationProperty relationProperty in cls.RelationProperties.OfType<EntityRelationProperty>().Where(r => r.Generate))
      AddCapabilityMember(map, relationProperty.GetProperty("Capabilities") as string, relationProperty);
    return map;
  }

  // Method AddCapabilityMember
  private void AddCapabilityMember(Dictionary<string, List<object>> map, string capabilities, object member) {
    if (string.IsNullOrWhiteSpace(capabilities))
      return;
    foreach (string capability in capabilities.Split(',')) {
      string name = codeProvider.GetValidIdentifier(capability.Trim());
      if (string.IsNullOrEmpty(name))
        continue;
      if (!map.ContainsKey(name))
        map[name] = new List<object>();
      map[name].Add(member);
    }
  }

