  // accessor carries its own when they differ (the entity template's rule).
  private void GetCapabilityMemberAccess(object member, out string propertyAccess, out string getAccess, out string setAccess) {
    MemberAccess getter = MemberAccess.Public;
    MemberAccess setter = MemberAccess.Public;
    var property = member as EntityProperty;
    if (property != null) {
      getter = property.GetterModifier;
      setter = property.SetterModifier;
