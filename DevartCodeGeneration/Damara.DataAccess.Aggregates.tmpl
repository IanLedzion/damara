  // Method GenerateCapableClass
  // A capable class ({ClassName}Definition) composes the listed capabilities:
  // it exposes one {Capability}Capability instance per capability and
  // delegates every tagged member to its owning capability (first listed
  // capability owns a member appearing in several), so the definition is the
  // flat member facade MCP fields and name templates read by name.
  private void GenerateCapableClass(EntityClass cls, string className, List<string> capabilityNames, Dictionary<string, List<object>> capabilities, string entityTypeName) {
    string definitionName = className + "Definition";
    string entityName = codeProvider.GetValidIdentifier(cls.Name);
    string entityReceiver = codeProvider.GetValidIdentifier(FirstCharToLowerCase(entityName));
    string baseName = entityName + "DefinitionBase";
    string _namespace = codeProvider.GetValidIdentifier(model.GetDefaultNamespace()) + "." + GetAggregateName(cls) + ".Definitions";
    OutputInfo classOutput = GetSubfolderOutput(CapabilityOutput, Path.Combine(GetAggregateName(cls), "Definitions"));

    var backings = GetCapabilityBackings(cls);
    var capabilityProperties = new Dictionary<string, string>();
    foreach (string capability in capabilityNames)
      capabilityProperties[capability] = capability + "Capability";

    // union of members over the listed capabilities. A member stamped on the
    // same entity property by several capabilities is one value, so the first
    // listed capability carries it; two capabilities exposing the same name over
    // different storage (a backed capability's own column) would make the
    // definition's member silently mean one of them, so generation refuses.
    var memberOwners = new List<KeyValuePair<object, string>>();
    foreach (string capability in capabilityNames) {
      foreach (object member in capabilities[capability]) {
        string name = GetCapabilityMemberName(member);
        var owner = memberOwners.FirstOrDefault(o => GetCapabilityMemberName(o.Key) == name);
        if (owner.Key == null) {
          memberOwners.Add(new KeyValuePair<object, string>(member, capability));
          continue;
        }
        if (owner.Key != member)
          throw new InvalidOperationException(string.Format("Class {0}: definition {1} composes capabilities {2} and {3}, which both have a member {4} over different storage. A definition may compose only one of them.", cls.Name, definitionName, owner.Value, capability, name));
      }
    }

    output.Extension = ".cs";
    output.PushOutputRedirection(classOutput, "", definitionName, OverwriteMode.None);
#>
