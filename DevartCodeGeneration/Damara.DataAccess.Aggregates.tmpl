  // Method GetSubfolderOutput
  // An OutputInfo pointing at a subfolder of the given output, supporting both
  // folder-based and project-based output configurations.
  private OutputInfo GetSubfolderOutput(OutputInfo baseOutput, string subPath) {
    OutputInfo info = new OutputInfo();
    if (string.IsNullOrEmpty(baseOutput.Project)) {
      info.DestinationFolder = Path.Combine(baseOutput.DestinationFolder, subPath);
      Directory.CreateDirectory(info.DestinationFolder);
    }
    else {
      info.Project = baseOutput.Project;
      info.ProjectFolder = string.IsNullOrEmpty(baseOutput.ProjectFolder) ? subPath : Path.Combine(baseOutput.ProjectFolder, subPath);
    }
    return info;
  }

  // Method GetCapabilityMembers
  // Capability name -> members: those tagged with it via the comma-separated
  // Capabilities extended property on Property and RelationProperty (a stamped
  // capability), or the members of the child entity backing it (a backed
  // capability, see GetCapabilityBackings). A capability is one or the other.
  private Dictionary<string, List<object>> GetCapabilityMembers(EntityClass cls) {
    var map = new Dictionary<string, List<object>>();
    foreach (EntityProperty property in cls.Properties.OfType<EntityProperty>())
      AddCapabilityMember(map, property.GetProperty("Capabilities") as string, property);
    foreach (EntityRelationProperty relationProperty in cls.RelationProperties.OfType<EntityRelationProperty>().Where(r => r.Generate))
      AddCapabilityMember(map, relationProperty.GetProperty("Capabilities") as string, relationProperty);
    if (map.Count > 0 && IsCapabilityBackingClass(cls))
      throw new InvalidOperationException(string.Format("Class {0} backs a capability, so its members cannot carry Capabilities stamps of their own ({1}).", cls.Name, string.Join(", ", map.Keys.ToArray())));
    foreach (var backing in GetCapabilityBackings(cls)) {
      if (map.ContainsKey(backing.Key))
        throw new InvalidOperationException(string.Format("Class {0}: capability {1} is both stamped on members and backed by {2}; a capability is one or the other.", cls.Name, backing.Key, backing.Value.Name));
      map[backing.Key] = GetBackedCapabilityMembers(backing.Value);
    }
    return map;
  }

  // Method AddCapabilityMember
  private void AddCapabilityMember(Dictionary<string, List<object>> map, string capabilities, object member) {
    if (string.IsNullOrWhiteSpace(capabilities))
      return;
    foreach (string capability in capabilities.Split(',')) {
      string name = codeProvider.GetValidIdentifier(capability.Trim());
      if (string.IsNullOrEmpty(name))
        continue;
      if (!map.ContainsKey(name))
        map[name] = new List<object>();
      map[name].Add(member);
    }
  }

  // Method GetCapabilityBackings
  // Backed capability name -> the root's navigation to the child entity backing
  // it, from the CapabilityBacking extended property. The navigation is a
  // generated zero-or-one navigation with a non-public getter (the child row is
  // reached through the capability only); the child belongs to the root's
  // aggregate and has no validator of its own (the capability validator holds
  // its rules).
  private Dictionary<string, EntityRelationProperty> GetCapabilityBackings(EntityClass cls) {
    var map = new Dictionary<string, EntityRelationProperty>();
    foreach (EntityRelationProperty relationProperty in cls.RelationProperties.OfType<EntityRelationProperty>()) {
      string value = relationProperty.GetProperty("CapabilityBacking") as string;
      if (string.IsNullOrWhiteSpace(value))
        continue;
      string capability = codeProvider.GetValidIdentifier(value.Trim());
      string where = string.Format("Class {0}: navigation {1} backing capability {2}", cls.Name, relationProperty.Name, capability);
      if (!relationProperty.Generate)
        throw new InvalidOperationException(where + " must be generated.");
      if (relationProperty.Multiplicity != Multiplicity.ZeroOrOne)
        throw new InvalidOperationException(where + " must be zero-or-one (a child row per root, created by Ensure).");
      if (relationProperty.GetterModifier == MemberAccess.Public)
        throw new InvalidOperationException(where + " must have a non-public getter (getter-modifier Internal): the child row is reached through the capability.");
      var child = (EntityClass)relationProperty.RelationClass;
      if (GetAggregateName(child) != GetAggregateName(cls))
        throw new InvalidOperationException(where + string.Format(": {0} must belong to the {1} aggregate (AggregateRootName).", child.Name, GetAggregateName(cls)));
      if ((bool)child.GetProperty("GenerateValidator"))
        throw new InvalidOperationException(where + string.Format(": {0} must not generate a validator (GenerateValidator False) - the capability validator holds its rules.", child.Name));
      var backReference = relationProperty.OppositeRelationProperty as EntityRelationProperty;
      if (!(bool)child.GetProperty("GenerateFactory") || !(bool)child.GetProperty("GenerateRepository") || backReference == null || !backReference.Generate || !(bool)backReference.GetProperty("GenerateFactoryParameter"))
