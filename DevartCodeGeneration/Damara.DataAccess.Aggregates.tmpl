  // Method IsAggregateRoot
  // An entity is the root of its aggregate when its AggregateRoot extended
  // property is set, or otherwise when the aggregate carries its name. The flag
  // lets an aggregate be named apart from its root (Guarantees for Guarantee),
  // so the aggregate namespace does not hide the root class's simple name.
  private bool IsAggregateRoot(EntityClass cls) {
    object aggregateRoot = cls.GetProperty("AggregateRoot");
    if (aggregateRoot is bool && (bool)aggregateRoot)
      return true;
    return string.Equals(GetAggregateName(cls), codeProvider.GetValidIdentifier(cls.Name));
  }

  // Method GetEmittedNamespace
  // The namespace a code element is generated into by the Aggregates EFCore
  // template: entity classes get {DefaultNamespace}.{Aggregate}.Entities;
  // complex types and enums share {DefaultNamespace}.Entities.
  private string GetEmittedNamespace(ICodeElement element) {
    if (!string.IsNullOrEmpty(element.Namespace))
      return codeProvider.GetValidIdentifier(element.Namespace);
    string root = codeProvider.GetValidIdentifier(model.GetDefaultNamespace());
    if (element is EntityClass)
      return root + "." + GetAggregateName((EntityClass)element) + ".Entities";
    return root + ".Entities";
  }

