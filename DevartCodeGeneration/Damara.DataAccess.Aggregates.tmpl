  // Method GenerateCapableClass
  // A capable class ({ClassName}Definition) composes the listed capabilities:
  // it implements each I{Capability}, wraps one {Capability}Capability
  // instance per capability and delegates every tagged member to its owning
  // capability (first listed capability owns a member appearing in several).
  private void GenerateCapableClass(EntityClass cls, string className, List<string> capabilityNames, Dictionary<string, List<object>> capabilities, string entityTypeName) {
    string definitionName = className + "Definition";
    string entityName = codeProvider.GetValidIdentifier(cls.Name);
    string entityReceiver = codeProvider.GetValidIdentifier(FirstCharToLowerCase(entityName));
    string _namespace = codeProvider.GetValidIdentifier(model.GetDefaultNamespace()) + "." + GetAggregateName(cls) + ".Definitions";
    OutputInfo classOutput = GetSubfolderOutput(CapabilityOutput, Path.Combine(GetAggregateName(cls), "Definitions"));

    var interfaceNames = new List<string>();
    var capabilityProperties = new Dictionary<string, string>();
    foreach (string capability in capabilityNames) {
      interfaceNames.Add(GetCapabilityNamespace(cls, capability) + ".I" + capability + "Capability");
      capabilityProperties[capability] = capability + "Capability";
    }

    // union of members over the listed capabilities; first capability wins
    var memberOwners = new List<KeyValuePair<object, string>>();
    var seenMembers = new List<string>();
    foreach (string capability in capabilityNames) {
      foreach (object member in capabilities[capability]) {
        string name = GetCapabilityMemberName(member);
        if (seenMembers.Contains(name))
          continue;
        seenMembers.Add(name);
        memberOwners.Add(new KeyValuePair<object, string>(member, capability));
