  // Method GetPropertyType
  private string GetPropertyType(Property prop, string _namespace) {
    string propertyDataType = string.Empty;
    if (prop.Type is ICodeElement) {
      propertyDataType = codeProvider.GetValidIdentifier(((ICodeElement)prop.Type).Name);
      if (!(prop.IsEnumType && ((EnumType)prop.Type).IsExternal && string.IsNullOrEmpty(((ICodeElement)prop.Type).Namespace))) {
        string nspace = GetEmittedNamespace((ICodeElement)prop.Type);
        if (nspace != _namespace)
          propertyDataType = nspace + "." + propertyDataType;
      }
      if (prop.IsEnumType && prop.Nullable)
        propertyDataType = codeProvider.FormatNullable(propertyDataType);
    }
    else
      propertyDataType = codeProvider.GetNullableType(prop.Nullable, prop.Type);
    return propertyDataType;
  }

  // Method GetPropertyParameterType
  private string GetPropertyParameterType(Property prop, string _namespace) {
    string propertyDataType = string.Empty;
    var codeElementProp = prop.Type as ICodeElement;
    if (codeElementProp != null) {
      propertyDataType = codeProvider.GetValidIdentifier(codeElementProp.Name);
      if (!(prop.IsEnumType && ((EnumType)prop.Type).IsExternal && string.IsNullOrEmpty(codeElementProp.Namespace))) {
        string nspace = GetEmittedNamespace(codeElementProp);
        if (nspace != _namespace)
          propertyDataType = nspace + "." + propertyDataType;
      }
    }
    else {
      propertyDataType = codeProvider.GetNullableType(true, prop.Type);
    }
    return propertyDataType;
  }

  // Method GetPropertyIsValueType
  private bool GetPropertyIsValueType(Property prop) {
    if (prop.Type is EntityDeveloper.EntityFrameworkCore.EntityDataType) {
      var propType = Type.GetType("System." + prop.Type.ToString());
      if (propType == null) {
        return false;
      }

      return propType.IsValueType;
    }

    return false;
  }

  // Method GetRelationPropertyTypeName
  private string GetRelationPropertyTypeName(EntityRelationProperty relationProperty, string parentNamespace) {
    BaseClass relationClass = relationProperty.RelationClass;
    string relationClassName = codeProvider.GetValidIdentifier(relationClass.Name);
    string nspace = GetEmittedNamespace(relationClass);
    if (nspace != parentNamespace)
      relationClassName = nspace + "." + relationClassName;

    return relationClassName;
  }

  // Method IsGenerated
  // Whether a class takes part in generation: entity classes require an
  // AggregateRootName; everything else always generates.
  private bool IsGenerated(BaseClass cls) {
    EntityClass entityClass = cls as EntityClass;
    if (entityClass == null)
      return true;
    return !string.IsNullOrEmpty((entityClass.GetProperty("AggregateRootName") as string ?? string.Empty).Trim());
  }

  // Method GetAggregateName
  // The aggregate an entity belongs to, from the AggregateRootName extended property.
  private string GetAggregateName(EntityClass cls) {
    string aggregateName = (cls.GetProperty("AggregateRootName") as string ?? string.Empty).Trim();
    if (string.IsNullOrEmpty(aggregateName))
      aggregateName = "UnassignedAggregate";
    return codeProvider.GetValidIdentifier(aggregateName);
  }

  // Method IsAggregateRoot
  // An entity is the root of its aggregate when the aggregate carries its name.
  private bool IsAggregateRoot(EntityClass cls) {
    return string.Equals(GetAggregateName(cls), codeProvider.GetValidIdentifier(cls.Name));
  }

  // Method GetEmittedNamespace
  // The namespace a code element is generated into by the Aggregates EFCore
  // template: entity classes get {DefaultNamespace}.{Aggregate}.Entities;
  // complex types and enums share {DefaultNamespace}.Entities.
  private string GetEmittedNamespace(ICodeElement element) {
    if (!string.IsNullOrEmpty(element.Namespace))
      return codeProvider.GetValidIdentifier(element.Namespace);
    string root = codeProvider.GetValidIdentifier(model.GetDefaultNamespace());
    if (element is EntityClass)
      return root + "." + GetAggregateName((EntityClass)element) + ".Entities";
    return root + ".Entities";
  }

  // Method GetKindNamespace
  // The namespace for a data access artifact kind of an entity's aggregate.
  private string GetKindNamespace(EntityClass cls, string kind) {
    return codeProvider.GetValidIdentifier(model.GetDefaultNamespace()) + "." + GetAggregateName(cls) + "." + kind;
  }

  // Method GetSubfolderOutput
  // An OutputInfo pointing at a subfolder of the given output, supporting both
  // folder-based and project-based output configurations.
  private OutputInfo GetSubfolderOutput(OutputInfo baseOutput, string subPath) {
    OutputInfo info = new OutputInfo();
    if (string.IsNullOrEmpty(baseOutput.Project)) {
      info.DestinationFolder = Path.Combine(baseOutput.DestinationFolder, subPath);
      Directory.CreateDirectory(info.DestinationFolder);
    }
    else {
      info.Project = baseOutput.Project;
      info.ProjectFolder = string.IsNullOrEmpty(baseOutput.ProjectFolder) ? subPath : Path.Combine(baseOutput.ProjectFolder, subPath);
    }
    return info;
  }

  // Method GenerateGlobalUsings
  // Publishes the namespaces of every generated data access artifact plus the
  // libraries the generated code relies on.
  private void GenerateGlobalUsings(string dataAccessLayerNamespace) {
    var kindNamespaces = new List<string>();
    foreach (EntityClass cls in model.Classes.Cast<EntityClass>().Where(c => IsGenerated(c))) {
      if ((bool)cls.GetProperty("GenerateRepository"))
        kindNamespaces.Add(GetKindNamespace(cls, "Repositories"));
      if ((bool)cls.GetProperty("GenerateFactory"))
        kindNamespaces.Add(GetKindNamespace(cls, "Factories"));
      if ((bool)cls.GetProperty("GenerateDomainService"))
        kindNamespaces.Add(GetKindNamespace(cls, "DomainServices"));
      if ((bool)cls.GetProperty("GenerateValidator"))
        kindNamespaces.Add(GetKindNamespace(cls, "Validation"));
    }
    var namespaces = kindNamespaces.Concat(new[] { dataAccessLayerNamespace }).Distinct().OrderBy(n => n, StringComparer.Ordinal).ToList();
    output.Extension = ".cs";
    output.PushOutputRedirection(DataAccessLayerOutput, "", "GlobalUsings.DataAccess.Generated");
    GenerateFileHeader(true);
