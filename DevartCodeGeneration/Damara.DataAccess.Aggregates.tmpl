  //------------------------------------------------------------------------------
  // Capability slice generation: for every entity class with members tagged
  // via the Capabilities extended property, generates the capability slice
  // under {Aggregate}\Capabilities\{Capability} - partial pairs for the
  // interface (I{Capability}Capability) and the capability instance class
  // ({Capability}Capability) wrapping the entity: its constructor observes the
  // entity's lifecycle (On{Entity}Created / On{Entity}PropertyChanging /
  // On{Entity}PropertyChanged) and it carries the tagged members with
  // On*Changing / On*Changed hooks, all as elidable instance partial methods.
  //------------------------------------------------------------------------------
  private void GenerateEntityCapabilityClasses(string unitOfWorkName, string unitOfWorkNamespace) {
    foreach (EntityClass cls in model.Classes.Cast<EntityClass>().Where(c => IsGenerated(c))) {
      var capabilities = GetCapabilityMembers(cls);
      var capableClasses = GetCapableClasses(cls);

      // capabilities referenced only by a capable class still get their
      // interface and capability class, with no members
      foreach (var capableClass in capableClasses)
        foreach (string capability in capableClass.Value)
          if (!capabilities.ContainsKey(capability))
            capabilities[capability] = new List<object>();

      if (capabilities.Count == 0)
        continue;

      string entityTypeName = GetEmittedNamespace(cls) + "." + codeProvider.GetValidIdentifier(cls.Name);
      bool generateValidators = (bool)cls.GetProperty("GenerateValidator");

      foreach (var capabilityPair in capabilities.OrderBy(p => p.Key, StringComparer.Ordinal)) {
        string capability = capabilityPair.Key;
        List<object> members = capabilityPair.Value;
        string _namespace = GetCapabilityNamespace(cls, capability);
        OutputInfo capabilityOutput = GetSubfolderOutput(CapabilityOutput, Path.Combine(GetAggregateName(cls), "Capabilities", capability));

        GenerateCapabilityInterface(cls, capability, members, _namespace, capabilityOutput, entityTypeName);
        GenerateCapabilityClass(cls, capability, members, _namespace, capabilityOutput, entityTypeName);
        if (generateValidators)
          GenerateCapabilityValidator(cls, capability, members, _namespace, capabilityOutput, unitOfWorkName, unitOfWorkNamespace);
      }

      foreach (var capableClass in capableClasses.OrderBy(p => p.Key, StringComparer.Ordinal)) {
        GenerateCapableClass(cls, capableClass.Key, capableClass.Value, capabilities, entityTypeName);
        if (generateValidators)
          GenerateCapableClassValidator(cls, capableClass.Key, capableClass.Value, unitOfWorkName, unitOfWorkNamespace);
      }
    }
  }

  // Method GetCapableClasses
  // Capable class name -> ordered capability list, parsed from the
  // CapableClasses extended property: {Class1}:{Cap1},{Cap2};{Class2}:...
  private Dictionary<string, List<string>> GetCapableClasses(EntityClass cls) {
    var map = new Dictionary<string, List<string>>();
    string value = cls.GetProperty("CapableClasses") as string;
    if (string.IsNullOrWhiteSpace(value))
      return map;
    foreach (string entry in value.Split(';')) {
      if (string.IsNullOrWhiteSpace(entry))
        continue;
      string[] parts = entry.Split(':');
      if (parts.Length != 2)
        throw new InvalidOperationException(string.Format("Class {0}: CapableClasses entry '{1}' is not {{ClassName}}:{{Capability}},...", cls.Name, entry.Trim()));
      string className = codeProvider.GetValidIdentifier(parts[0].Trim());
      var capabilityNames = new List<string>();
      foreach (string capability in parts[1].Split(',')) {
        string name = codeProvider.GetValidIdentifier(capability.Trim());
        if (!string.IsNullOrEmpty(name) && !capabilityNames.Contains(name))
          capabilityNames.Add(name);
      }
      if (capabilityNames.Count == 0)
        throw new InvalidOperationException(string.Format("Class {0}: capable class '{1}' lists no capabilities.", cls.Name, className));
      map[className] = capabilityNames;
    }
    return map;
  }

