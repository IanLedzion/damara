  // Method GenerateGlobalUsings
  // Publishes the namespaces of every generated data access artifact plus the
  // libraries the generated code relies on.
  private void GenerateGlobalUsings(string dataAccessLayerNamespace) {
    var kindNamespaces = new List<string>();
    foreach (EntityClass cls in model.Classes.Cast<EntityClass>().Where(c => IsGenerated(c))) {
      foreach (string capability in GetCapabilityMembers(cls).Keys)
        kindNamespaces.Add(GetCapabilityNamespace(cls, capability));
      foreach (var capableClass in GetCapableClasses(cls))
        foreach (string capability in capableClass.Value)
          kindNamespaces.Add(GetCapabilityNamespace(cls, capability));
      if (GetCapableClasses(cls).Count > 0)
        kindNamespaces.Add(codeProvider.GetValidIdentifier(model.GetDefaultNamespace()) + "." + GetAggregateName(cls) + ".Definitions");
      if ((bool)cls.GetProperty("GenerateRepository"))
        kindNamespaces.Add(GetKindNamespace(cls, "Repositories"));
      if ((bool)cls.GetProperty("GenerateFactory"))
        kindNamespaces.Add(GetKindNamespace(cls, "Factories"));
      if ((bool)cls.GetProperty("GenerateDomainService"))
        kindNamespaces.Add(GetKindNamespace(cls, "DomainServices"));
      if ((bool)cls.GetProperty("GenerateValidator"))
        kindNamespaces.Add(GetKindNamespace(cls, "Validation"));
    }
    var namespaces = kindNamespaces.Concat(new[] { dataAccessLayerNamespace }).Distinct().OrderBy(n => n, StringComparer.Ordinal).ToList();
    output.Extension = ".cs";
    output.PushOutputRedirection(DataAccessLayerOutput, "", "GlobalUsings.DataAccess.Generated");
    GenerateFileHeader(true);
#>

<#+
    foreach (string globalUsingNamespace in namespaces) {
#>
global using <#= globalUsingNamespace #>;
<#+
    }
#>

global using FluentValidation;
<#+
    output.PopOutputRedirection();
  }

  // Method GetRelationPropertyTypeName
  static string FirstCharToLowerCase(string str) {
    if (!string.IsNullOrEmpty(str) && char.IsUpper(str[0]))
      return str.Length == 1 ? char.ToLower(str[0]).ToString() : char.ToLower(str[0]) + str.Substring(1);

    return str;
  }

  // Determines whether a class has descendents.
  private bool HasDescendents(Class cls) {
    return model.Classes.Cast<Class>().Where(c => c.BaseInheritance != null).Select(c => c.BaseInheritance).Any(bi => bi.BaseClass == cls);
  }

  // Gets a class' base inheritahce hierarchy
  private IEnumerable<EntityClass> GetBaseInheritahceHierarchy(EntityClass cls) {
    var baseClasses = new List<EntityClass>();
    baseClasses.Add(cls);

    if (cls.BaseInheritance == null) {
      return baseClasses;
    }

    baseClasses.AddRange(GetBaseInheritahceHierarchy((EntityClass)cls.BaseInheritance.BaseClass));
    return baseClasses;
  }
