        throw new InvalidOperationException(where + string.Format(": the capability is already backed by {0}.", map[capability].Name));
      map[capability] = relationProperty;
    }
    return map;
  }

  // Method IsCapabilityBackingClass
  // Whether the class is the child entity backing a capability of another class.
  private bool IsCapabilityBackingClass(EntityClass cls) {
    return model.Classes.Cast<EntityClass>()
      .SelectMany(c => c.RelationProperties.OfType<EntityRelationProperty>())
      .Any(r => r.RelationClass == cls && !string.IsNullOrWhiteSpace(r.GetProperty("CapabilityBacking") as string));
